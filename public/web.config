<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS rules for the static FTP deploy (dist/DynaOpsSite/browser). Apache uses .htaccess instead. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- The site has no home page yet: send each language root to the FMCG page. -->
        <rule name="Root to FMCG" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/industries/fmcg" redirectType="Permanent" />
        </rule>
        <rule name="Arabic root to FMCG" stopProcessing="true">
          <match url="^ar/?$" />
          <action type="Redirect" url="/ar/industries/fmcg" redirectType="Permanent" />
        </rule>
        <!-- Canonical URLs have no trailing slash: /industries/fmcg/ -> /industries/fmcg -->
        <rule name="Strip trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Serve each prerendered folder page (/industries/fmcg/index.html) at its canonical URL. -->
        <rule name="Folder page" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>
      </rules>
      <!-- Pages, robots.txt and the sitemap keep unhashed URLs, so browsers must revalidate them. -->
      <outboundRules>
        <rule name="Revalidate unhashed text">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/(html|plain|xml)" />
          </conditions>
          <action type="Rewrite" value="public, max-age=0, must-revalidate" />
        </rule>
      </outboundRules>
    </rewrite>
    <directoryBrowse enabled="false" />
    <!-- Unknown URLs get the prerendered not-found page. File mode keeps the 404; ExecuteURL answered 200. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="404\index.html" responseMode="File" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
  <!-- Images and icons keep their file names when replaced, so they get 7 days, not the host's 1 year. -->
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="icons">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="brand">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Arabic URLs get the Arabic not-found page. -->
  <location path="ar">
    <system.webServer>
      <httpErrors errorMode="Custom" existingResponse="Replace">
        <remove statusCode="404" />
        <error statusCode="404" path="ar\404\index.html" responseMode="File" />
      </httpErrors>
    </system.webServer>
  </location>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS rules for the static FTP deploy (dist/DynaOpsSite/browser). Apache uses .htaccess instead. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- The site has no home page yet: send each language root to the FMCG page. -->
        <rule name="Root to FMCG" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/industries/fmcg" redirectType="Permanent" />
        </rule>
        <rule name="Arabic root to FMCG" stopProcessing="true">
          <match url="^ar/?$" />
          <action type="Redirect" url="/ar/industries/fmcg" redirectType="Permanent" />
        </rule>
        <!-- Canonical URLs have no trailing slash: /industries/fmcg/ -> /industries/fmcg -->
        <rule name="Strip trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Serve each prerendered folder page (/industries/fmcg/index.html) at its canonical URL. -->
        <rule name="Folder page" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>
      </rules>
    </rewrite>
    <directoryBrowse enabled="false" />
    <!-- Unknown URLs get the prerendered not-found page with a real 404 status. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404/index.html" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
  <!-- Arabic URLs get the Arabic not-found page. -->
  <location path="ar">
    <system.webServer>
      <httpErrors errorMode="Custom" existingResponse="Replace">
        <remove statusCode="404" />
        <error statusCode="404" path="/ar/404/index.html" responseMode="ExecuteURL" />
      </httpErrors>
    </system.webServer>
  </location>
</configuration>

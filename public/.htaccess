# Apache rules for the static FTP deploy (dist/DynaOpsSite/browser). IIS uses web.config instead.

Options -Indexes
# Canonical URLs have no trailing slash; the rules below serve folder pages without one.
DirectorySlash Off

RewriteEngine On

# The site has no home page yet: send each language root to the FMCG page.
RewriteRule ^$ /industries/fmcg [R=301,L]
RewriteRule ^ar/?$ /ar/industries/fmcg [R=301,L]

# /industries/fmcg/ -> /industries/fmcg
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve each prerendered folder page (/industries/fmcg/index.html) at its canonical URL.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Compress text files, SVGs included; images like webp are already compressed.
<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript image/svg+xml application/manifest+json
  </IfModule>
</IfModule>

# Pages, robots.txt, the sitemap and the manifest keep unhashed URLs, so browsers must revalidate them.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Every JS and CSS file is hashed by the build, so a changed file gets a new URL.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and icons keep their file names when replaced, so they get 7 days.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Unknown URLs get the prerendered not-found page in their language.
ErrorDocument 404 /404/index.html
<If "%{REQUEST_URI} =~ m#^/ar(/|$)#">
  ErrorDocument 404 /ar/404/index.html
</If>

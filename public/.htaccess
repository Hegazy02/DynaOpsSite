# Apache rules for the static FTP deploy (dist/DynaOpsSite/browser). IIS uses web.config instead.

Options -Indexes
# Canonical URLs have no trailing slash; the rules below serve folder pages without one.
DirectorySlash Off

RewriteEngine On

# The site has no home page yet: send each language root to the FMCG page.
RewriteRule ^$ /industries/fmcg [R=301,L]
RewriteRule ^ar/?$ /ar/industries/fmcg [R=301,L]

# /industries/fmcg/ -> /industries/fmcg
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve each prerendered folder page (/industries/fmcg/index.html) at its canonical URL.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Pages, robots.txt and the sitemap keep unhashed URLs, so browsers must revalidate them.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Images and icons keep their file names when replaced, so they get 7 days.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Unknown URLs get the prerendered not-found page in their language.
ErrorDocument 404 /404/index.html
<If "%{REQUEST_URI} =~ m#^/ar(/|$)#">
  ErrorDocument 404 /ar/404/index.html
</If>

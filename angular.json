{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "DynaOpsSite": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["www.dynaops365.com", "dynaops365.com"]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": ["@angular/localize/init"],
            "localize": true,
            "i18nMissingTranslation": "error",
            "i18nDuplicateTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "outputHashing": "all",
              "extractLicenses": false,
              "sourceMap": true,
              "security": {
                "allowedHosts": ["localhost", "127.0.0.1"]
              }
            },
            "en": {
              "localize": ["en"]
            },
            "ar": {
              "localize": ["ar"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "DynaOpsSite:build:production"
            },
            "development": {
              "buildTarget": "DynaOpsSite:build:development,en"
            },
            "ar": {
              "buildTarget": "DynaOpsSite:build:development,ar"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "format": "json",
            "outputPath": "src/locale"
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": ""
        },
        "locales": {
          "ar": {
            "translation": [
              "src/locale/ar/header.json",
              "src/locale/ar/footer.json",
              "src/locale/ar/industries.json",
              "src/locale/ar/not-found.json"
            ],
            "subPath": "ar"
          }
        }
      }
    }
  }
}
